# ============================================================
#  Bermi Desktop (Jarvis)  —  configuration
#  Copy this file to ".env" and fill in your values.
#  NEVER commit your real .env — it is gitignored.
# ============================================================

# --- OpenRouter (the brain) -------------------------------------------------
# Get / rotate your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Any model on https://openrouter.ai/models works. Strong defaults:
#   anthropic/claude-3.7-sonnet   (great reasoning + tool use)
#   openai/gpt-4o                 (fast, reliable tool use)
#   google/gemini-2.0-flash-001   (cheap + fast)
BERMI_MODEL=anthropic/claude-3.7-sonnet

# --- Voice: Speech to text (faster-whisper, runs locally) -------------------
# tiny | base | small | medium | large-v3   (bigger = more accurate, slower)
WHISPER_MODEL=base
# cpu | cuda   (use cuda if you have an NVIDIA GPU)
WHISPER_DEVICE=cpu
# int8 (cpu) | float16 (gpu)
WHISPER_COMPUTE=int8

# --- Voice: Text to speech --------------------------------------------------
# edge (natural, online) | pyttsx3 (offline) | off
TTS_ENGINE=edge
# Any Microsoft Edge neural voice. Nice "Jarvis" options:
#   en-GB-RyanNeural  en-GB-ThomasNeural  en-US-GuyNeural  en-US-AndrewNeural
TTS_VOICE=en-GB-RyanNeural

# --- Safety -----------------------------------------------------------------
# When true, shell commands and other destructive actions require you to
# approve them in the UI before Bermi runs them. Strongly recommended.
REQUIRE_CONFIRMATION=true
# Comma-separated command prefixes that are ALWAYS blocked, even if confirmed.
BLOCKED_COMMANDS=rm -rf /,mkfs,:(){:|:&};:,shutdown -h now,dd if=

# --- Server -----------------------------------------------------------------
HOST=127.0.0.1
PORT=8787
# Bermi's persona name shown in the UI
ASSISTANT_NAME=Bermi
