# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://bermi:bermi@localhost:5432/bermi_ai

# ── Auth ──────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Model router (OpenRouter or any OpenAI-compatible API) ────────────
# Leave LLM_API_KEY empty to run in offline "echo" dev mode (no external calls).
LLM_API_BASE=https://openrouter.ai/api/v1
LLM_API_KEY=
# Default chat model — swappable via config, never hardcoded.
LLM_CHAT_MODEL=qwen/qwen3-32b
# Optional cheaper model used for restricted/student accounts.
LLM_LIGHT_MODEL=meta-llama/llama-3.1-8b-instruct

# ── Embeddings (OpenAI-compatible /embeddings endpoint) ───────────────
# Leave EMBEDDINGS_API_KEY empty to use the built-in deterministic dev
# embedder (works offline; fine for development, not for production).
EMBEDDINGS_API_BASE=https://openrouter.ai/api/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=baai/bge-m3
EMBEDDINGS_DIMENSIONS=1024

# ── Storage ───────────────────────────────────────────────────────────
# Local directory for uploaded documents (S3-compatible storage later).
UPLOAD_DIR=./uploads

# ── Frontend ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── CORS ──────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
