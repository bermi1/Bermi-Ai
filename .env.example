# ── Database ──────────────────────────────────────────────────────────
# Local dev default below. For production, paste a Supabase (free tier)
# Session-pooler URI — plain postgres:// URLs are normalised automatically.
DATABASE_URL=postgresql+psycopg://bermi:bermi@localhost:5432/bermi_ai

# ── Auth ──────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Model router (OpenRouter or any OpenAI-compatible API) ────────────
# Leave LLM_API_KEY empty to run in offline "echo" dev mode (no external calls).
# NEVER commit the real key — set it in the deployment environment only.
LLM_API_BASE=https://openrouter.ai/api/v1
LLM_API_KEY=
# Default chat model — swappable via config, never hardcoded.
LLM_CHAT_MODEL=qwen/qwen3-32b
# Optional cheaper model used for restricted/student accounts.
LLM_LIGHT_MODEL=meta-llama/llama-3.1-8b-instruct
# Public-facing model identity — users only ever see this name.
MODEL_DISPLAY_NAME="Bermi AI v1"

# ── Administration ────────────────────────────────────────────────────
# Comma-separated emails promoted to super_admin (manage the private
# system-wide policy library, e.g. Tanzania Vision 2050).
SUPER_ADMIN_EMAILS=

# ── Google integration (Calendar) — requires Google Cloud OAuth creds ─
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Embeddings (OpenAI-compatible /embeddings endpoint) ───────────────
# Leave EMBEDDINGS_API_KEY empty to use the built-in deterministic dev
# embedder (works offline; fine for development, not for production).
EMBEDDINGS_API_BASE=https://openrouter.ai/api/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=baai/bge-m3
EMBEDDINGS_DIMENSIONS=1024

# ── Storage ───────────────────────────────────────────────────────────
# Local directory for uploaded documents (S3-compatible storage later).
UPLOAD_DIR=./uploads

# ── Frontend ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── CORS ──────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
